# This project's dependency tree has an unresolvable peer conflict: the app runs
# react 18, while @material-ui/core@4 and antd@4 declare peers of react 16/17.
# Every install therefore needs legacy peer resolution, so set it here rather
# than relying on everyone remembering --legacy-peer-deps. This also keeps
# locally generated lock files the same shape as Dependabot's.
legacy-peer-deps=true
